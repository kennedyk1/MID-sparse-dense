{
  "name": "MID-sparse-dense",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm",
  "postStartCommand": "nohup python3 -m http.server 8000 --bind 127.0.0.1 </dev/null >/tmp/mid-sparse-dense-http.log 2>&1 &",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Comparador RGB e LiDAR",
      "onAutoForward": "openBrowserOnce"
    }
  }
}
